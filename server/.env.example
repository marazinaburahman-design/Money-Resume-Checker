# Server Port
PORT=4000

# Groq API Key (Stored on backend only - never expose to client)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (Verified on startup, e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/resume_analyzer?retryWrites=true&w=majority
# Example for Local: mongodb://127.0.0.1:27017/resume_analyzer
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/resume_analyzer?retryWrites=true&w=majority

# JWT Secret for Cookie Authentication
JWT_SECRET=your_jwt_secret_key_here

